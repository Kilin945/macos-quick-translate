<?xml version="1.0" encoding="UTF-8"?>
<!--
  LaunchAgent template for QuickTranslate (auto-start at login + crash auto-restart).

  To use:
    1. Replace __PROJECT_DIR__ with the absolute path to this repo
       (the folder containing translate.py).
    2. Save it WITHOUT the .sample suffix into ~/Library/LaunchAgents/, e.g.
         cp scripts/com.quicktranslate.plist.sample ~/Library/LaunchAgents/com.quicktranslate.plist
       then edit the copied file and substitute __PROJECT_DIR__.
    3. Load it:
         launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.quicktranslate.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.quicktranslate</string>

    <!-- launch the bundled jpackage binary directly (matches its Accessibility grant by path) -->
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/QuickTranslate.app/Contents/MacOS/QuickTranslate</string>
    </array>

    <!-- start at login -->
    <key>RunAtLoad</key>
    <true/>

    <!-- relaunch only when it dies abnormally (a crash); a clean exit (e.g. the single-instance
         guard bowing out) is left alone so we never thrash -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <!-- raw stdout/stderr (SLF4J notices, uncaught stack traces); the structured app log lives
         separately at <project>/logs/quicktranslate.log -->
    <key>StandardOutPath</key>
    <string>__PROJECT_DIR__/logs/quicktranslate.out.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_DIR__/logs/quicktranslate.out.log</string>
</dict>
</plist>

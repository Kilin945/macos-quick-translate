<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.kilin.quicktranslate</string>

    <!-- launch the bundled jpackage binary directly (matches its Accessibility grant by path) -->
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/QuickTranslate.app/Contents/MacOS/QuickTranslate</string>
    </array>

    <!-- start at login -->
    <key>RunAtLoad</key>
    <true/>

    <!-- relaunch only when it dies abnormally (a crash); a clean exit (e.g. the single-instance
         guard bowing out) is left alone so we never thrash -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <!-- raw stdout/stderr (SLF4J notices, uncaught stack traces); the structured app log lives
         separately at logs/quicktranslate.log -->
    <key>StandardOutPath</key>
    <string>/Users/yeqilin/Workspace/macos-quick-translate/logs/quicktranslate.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/yeqilin/Workspace/macos-quick-translate/logs/quicktranslate.out.log</string>
</dict>
</plist>
